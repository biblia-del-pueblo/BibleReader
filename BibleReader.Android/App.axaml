<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="BibleReader.Android.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- The Svg controls in the library use this to follow the theme (same as the desktop head). -->
                <ResourceDictionary x:Key="Light">
                    <sys:String x:Key="SvgThemeCss">path, rect { fill: #333333 !important; }</sys:String>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <sys:String x:Key="SvgThemeCss">path, rect { fill: #FFFFFF !important; }</sys:String>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
