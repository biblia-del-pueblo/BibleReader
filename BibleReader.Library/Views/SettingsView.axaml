<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:BibleReader.Library"
             x:Class="BibleReader.Library.UI.SettingsView">

    <Grid Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <ScrollViewer>
            <StackPanel Margin="16,12" Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
                <TextBlock Text="{loc:Loc Settings}" FontSize="{loc:Size 22}" FontWeight="SemiBold" />

                <!-- Appearance -->
                <StackPanel Spacing="16" Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Theme}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="OnThemeChanged"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="{loc:Loc ThemeSystem}" Tag="System" />
                        <ComboBoxItem Content="{loc:Loc ThemeLight}" Tag="Light" />
                        <ComboBoxItem Content="{loc:Loc ThemeDark}" Tag="Dark" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="16" Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Language}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ComboBox x:Name="LanguageBox" MinWidth="200" SelectionChanged="OnLanguageChanged"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="{loc:Loc ThemeSystem}" Tag="System" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="العربية" Tag="ar" />
                        <ComboBoxItem Content="中文（简体）" Tag="zh-Hans" />
                        <ComboBoxItem Content="Français" Tag="fr" />
                        <ComboBoxItem Content="Deutsch" Tag="de" />
                        <ComboBoxItem Content="Ελληνικά" Tag="el" />
                        <ComboBoxItem Content="עברית" Tag="he" />
                        <ComboBoxItem Content="日本語" Tag="ja" />
                        <ComboBoxItem Content="한국어" Tag="ko" />
                        <ComboBoxItem Content="Português" Tag="pt" />
                        <ComboBoxItem Content="Русский" Tag="ru" />
                        <ComboBoxItem Content="Español" Tag="es" />
                        <ComboBoxItem Content="Türkçe" Tag="tr" />
                        <ComboBoxItem Content="Italiano" Tag="it" />
                        <ComboBoxItem Content="Nederlands" Tag="nl" />
                        <ComboBoxItem Content="Polski" Tag="pl" />
                        <ComboBoxItem Content="Română" Tag="ro" />
                        <ComboBoxItem Content="Български" Tag="bg" />
                        <ComboBoxItem Content="Hrvatski" Tag="hr" />
                        <ComboBoxItem Content="Srpski" Tag="sr" />
                        <ComboBoxItem Content="Shqip" Tag="sq" />
                        <ComboBoxItem Content="Čeština" Tag="cs" />
                        <ComboBoxItem Content="Slovenčina" Tag="sk" />
                        <ComboBoxItem Content="Magyar" Tag="hu" />
                        <ComboBoxItem Content="Dansk" Tag="da" />
                        <ComboBoxItem Content="Svenska" Tag="sv" />
                        <ComboBoxItem Content="Norsk bokmål" Tag="nb" />
                        <ComboBoxItem Content="Suomi" Tag="fi" />
                        <ComboBoxItem Content="فارسی" Tag="fa" />
                        <ComboBoxItem Content="हिन्दी" Tag="hi" />
                        <ComboBoxItem Content="नेपाली" Tag="ne" />
                        <ComboBoxItem Content="اردو" Tag="ur" />
                        <ComboBoxItem Content="پښتو" Tag="ps" />
                        <ComboBoxItem Content="Հայերեն" Tag="hy" />
                        <ComboBoxItem Content="Bahasa Indonesia" Tag="id" />
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                        <ComboBoxItem Content="ไทย" Tag="th" />
                        <ComboBoxItem Content="ខ្មែរ" Tag="km" />
                        <ComboBoxItem Content="සිංහල" Tag="si" />
                        <ComboBoxItem Content="Filipino" Tag="fil" />
                        <ComboBoxItem Content="Монгол" Tag="mn" />
                        <ComboBoxItem Content="中文（繁體）" Tag="zh-Hant" />
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="LanguageHint" Opacity="0.7" TextWrapping="Wrap" IsVisible="False" />

                <!-- Reading -->
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{loc:Loc Font}" FontWeight="SemiBold"  VerticalAlignment="Center" />
                    <ComboBox x:Name="FontBox" Grid.Column="1" MinWidth="200" MaxWidth="400"
                              SelectionChanged="OnFontChanged" VerticalAlignment="Center" />
                    <Button x:Name="InstallFontButton" Grid.Column="2" Click="OnInstallFontClick" VerticalAlignment="Center" ToolTip.Tip="{loc:Loc InstallFont}">
                        <loc:ThemedSvg Path="/Assets/upload.svg" Size="18" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{loc:Loc FontSize}" Grid.Column="0" FontWeight="SemiBold"  VerticalAlignment="Center" />
                    <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="12" Maximum="40" SmallChange="1" LargeChange="2"
                        TickFrequency="1" IsSnapToTickEnabled="True"  VerticalAlignment="Center" />
                    <TextBlock x:Name="FontSizeText" Grid.Column="2" Opacity="0.7"  VerticalAlignment="Center" />
                </Grid>

                <!-- The size of the interface (its texts); the main window is made again in the size that is chosen. -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc UiSize}" Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Slider x:Name="UiSizeSlider" Grid.Column="0" Minimum="80" Maximum="200" SmallChange="5" LargeChange="10"
                                TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock x:Name="UiSizeText" Grid.Column="1" Opacity="0.7" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Click="OnUiSizeResetClick" ToolTip.Tip="{loc:Loc UiSizeReset}" VerticalAlignment="Center">
                            <loc:ThemedSvg Path="/Assets/cycle.svg" Size="16" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Installs a font file, or the fonts in a zip, into the Fonts folder of the settings. -->
                <TextBlock x:Name="FontStatus" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center" />

                <StackPanel Spacing="16" Orientation="Horizontal">
                    <CheckBox x:Name="JesusBox" Content="{loc:Loc ShowJesusRed}"
                              IsCheckedChanged="OnJesusChanged" />
                    <CheckBox x:Name="GreenVerseBox" Content="{loc:Loc ShowVersesGreen}"
                              IsCheckedChanged="OnGreenVerseChanged" />
                </StackPanel>

                <!-- Words are split at the end of a line (for the languages that have hyphenation patterns). -->
                <CheckBox x:Name="HyphenateBox" Content="{loc:Loc Hyphenation}"
                          IsCheckedChanged="OnHyphenateChanged" />

                <!-- Online Bibles are only listed when this is ticked. -->
                <CheckBox x:Name="NoPersecutionBox" Content="{loc:Loc NoPersecution}"
                          IsCheckedChanged="OnNoPersecutionChanged" />

                <!-- A short example of the text with the font settings above; it follows them at once (see UpdateSample). -->
                <Border Padding="12" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <TextBlock x:Name="SampleText" TextWrapping="Wrap">
                        <Run x:Name="VerseNumberRun" Text="16 " FontWeight="Bold" />
                        <Run Text="{loc:Loc SampleText1}" />
                        <Run x:Name="JesusRun" Text="{loc:Loc SampleText2}" />
                    </TextBlock>
                </Border>

                <!-- Information -->
                <StackPanel Spacing="6">
                    <StackPanel Spacing="16" Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc Storage}" FontWeight="SemiBold" />
                        <SelectableTextBlock x:Name="PathText" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="BiblesText" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <!-- Back to reading, in the upper right corner. -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                Padding="8,6" Background="Transparent" BorderThickness="0"
                ToolTip.Tip="{loc:Loc Close}" Click="OnCloseClick">
            <loc:ThemedSvg Path="/Assets/close.svg" Size="16" />
        </Button>
    </Grid>
</UserControl>
