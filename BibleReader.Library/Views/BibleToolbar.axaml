<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="BibleReader.Library.UI.BibleToolbar">

    <UserControl.Styles>
        <!-- A cell of the book / chapter grid (the buttons are added in code). -->
        <Style Selector="Button.cell">
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <!-- Book buttons are tinted by Bible.Book.Class (the class name is added in code). The fills are translucent,
             so the same colours work on light and dark backgrounds. Prefix and Appendix stay uncoloured. -->
        <Style Selector="Button.cell.Pentateuch"><Setter Property="Background" Value="#664C8BF5" /></Style>
        <Style Selector="Button.cell.Historical"><Setter Property="Background" Value="#66A0764A" /></Style>
        <Style Selector="Button.cell.PoetryAndWisdom"><Setter Property="Background" Value="#6648B58A" /></Style>
        <Style Selector="Button.cell.MajorProphets"><Setter Property="Background" Value="#66E0903C" /></Style>
        <Style Selector="Button.cell.MinorProphets"><Setter Property="Background" Value="#66E0C03C" /></Style>
        <Style Selector="Button.cell.Gospels"><Setter Property="Background" Value="#66D9534F" /></Style>
        <Style Selector="Button.cell.Acts"><Setter Property="Background" Value="#66D9739F" /></Style>
        <Style Selector="Button.cell.Epistles"><Setter Property="Background" Value="#668F66D9" /></Style>
        <Style Selector="Button.cell.Revelation"><Setter Property="Background" Value="#6640B8C8" /></Style>
        <Style Selector="Button.cell.Apocrypha"><Setter Property="Background" Value="#66909090" /></Style>
        <!-- An entry of the menu popup (the buttons are added in code). -->
        <Style Selector="Button.entry.current"><Setter Property="FontWeight" Value="Bold" /></Style>
        <Style Selector="Button.entry">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- The book or chapter the text block is at. -->
        <Style Selector="Button.cell.current">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Theme brushes (not fixed colours): the bar and its popup follow light/dark mode, including live switches. -->
    <Border Padding="8,2"
            BorderThickness="0,0,0,1"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="MenuButton"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Padding="8,4"
                        BorderThickness="0"
                        Background="Transparent"
                        Cursor="Hand"
                        Click="OnMenuClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <svg:Svg x:Name="Menu" Path="/Assets/bars.svg" Width="18" Height="18"
                            Css="{DynamicResource SvgThemeCss}" />
                    </StackPanel>
                </Button>
                <!-- The position is a flat button: it looks like text until hovered. -->
                <Button x:Name="PositionButton"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Padding="8,4"
                        BorderThickness="0"
                        Background="Transparent"
                        Cursor="Hand"
                        Click="OnPositionClick">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel>
                            <TextBlock x:Name="BookName" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="18"/>
                            <TextBlock x:Name="BibleName" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                        <TextBlock x:Name="ReferenceText" Opacity="0.8" VerticalAlignment="Center" />
                        <!-- Direct Svg tag -->
                        <svg:Svg Path="/Assets/down-arrow.svg" Width="18" Height="18"
                                Css="{DynamicResource SvgThemeCss}" />
                        <TextBlock Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- The installed Bibles: opens a list to choose the Bible to read. -->
                <Button x:Name="BiblesButton"
                        VerticalAlignment="Center"
                        Padding="8,4"
                        BorderThickness="0"
                        Background="Transparent"
                        Cursor="Hand"
                        ToolTip.Tip="Installed Bibles"
                        Click="OnBiblesClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <svg:Svg Path="/Assets/bookshelf.svg" Width="30" Height="30"
                                Css="{DynamicResource SvgThemeCss}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- The menu: opened by the menu button, its entries are added in code. -->
            <Popup x:Name="MenuPopup"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True"
                   Closed="OnMenuPopupClosed">
                <Border MinWidth="200"
                        Padding="4"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel x:Name="MenuItems" />
                </Border>
            </Popup>

            <!-- The installed Bibles; its entries are added in code. -->
            <Popup x:Name="BiblesPopup"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True"
                   Closed="OnBiblesPopupClosed">
                <Border MinWidth="220"
                        Padding="4"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <ScrollViewer MaxHeight="400" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="BiblesItems" />
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Book grid, or (after choosing a book) the chapter grid with a header to go back. -->
            <Popup x:Name="BookPopup"
                   Placement="BottomEdgeAlignedLeft"
                   IsLightDismissEnabled="True"
                   Closed="OnPopupClosed">
                <Border Padding="6"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel>
                        <StackPanel x:Name="ChapterHeader" Orientation="Horizontal" Spacing="10" Margin="2,0,2,6" IsVisible="False">
                            <Button Content="‹  Books" Padding="10,4" Background="Transparent" Click="OnBackClick" />
                            <TextBlock x:Name="TitleText" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="600" HorizontalScrollBarVisibility="Disabled">
                            <UniformGrid x:Name="BookGrid" Columns="6" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</UserControl>
