<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="ViewModels\ReaderModel.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="ViewModels\ReaderModel.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" />
        <PackageReference Include="EstrellasDeEsperanza.AsyncLock" />
        <PackageReference Include="LibArchive.Net" />
        <PackageReference Include="HtmlAgilityPack" />
        <PackageReference Include=" System.Linq.AsyncEnumerable" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BibleMarkdown\BibleMarkdown\BibleMarkdown.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Reader.axaml.cs">
            <DependentUpon>Reader.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\BibleToolbar.axaml.cs">
            <DependentUpon>BibleToolbar.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\BibleView.axaml.cs">
            <DependentUpon>BibleView.axaml</DependentUpon>
        </Compile>
    </ItemGroup>
</Project>
