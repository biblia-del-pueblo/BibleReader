<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <NeutralLanguage>en</NeutralLanguage> <!-- the language of Resources/Strings.resx; the others are Strings.de.resx ... -->
        <LangVersion>latest</LangVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <DefineConstants>$(DefineConstants);BibleReader</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- InstallableBook is shared with BibleMarkdown, where it also reads info.json (see the #if BibleReader in it). -->
        <Compile Include="..\BibleMarkdown\BibleMarkdown\InstallableBook.cs" Link="Downloads\InstallableBook.cs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Models\ReaderModel.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Models\ReaderModel.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" />
        <PackageReference Include="EstrellasDeEsperanza.AsyncLock" />
        <PackageReference Include="NHyphenator" />
        <PackageReference Include="HtmlAgilityPack" />
        <PackageReference Include=" System.Linq.AsyncEnumerable" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BibleMarkdown\BibleMarkdown\BibleMarkdown.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Reader.axaml.cs">
            <DependentUpon>Reader.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\BibleToolbar.axaml.cs">
            <DependentUpon>BibleToolbar.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\BibleView.axaml.cs">
            <DependentUpon>BibleView.axaml</DependentUpon>
        </Compile>
    </ItemGroup>
</Project>
