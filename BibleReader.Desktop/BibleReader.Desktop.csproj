<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--If you are willing to use Windows/MacOS native APIs you will need to create 3 projects.
    One for Windows with net8.0-windows TFM, one for MacOS with net8.0-macos and one with net8.0 TFM for Linux.-->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Assets\CrossBible-logo.ico" />
        <None Remove="Assets\logo.icns" />
        <None Remove="Assets\logo.ico" />
        <None Remove="Assets\logo.svg" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="Assets\logo.icns" />
      <AvaloniaResource Include="Assets\logo.ico" />
      <AvaloniaResource Include="Assets\logo.svg" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BibleReader.Library\BibleReader.Library.csproj" />
    </ItemGroup>
</Project>
